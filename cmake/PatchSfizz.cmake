# sfizz 1.2.3 declares the cxxopts alias in both the bundled branch
# and after the conditional. Keep only one declaration per configuration.
if(NOT DEFINED SFIZZ_SOURCE_DIR)
    message(FATAL_ERROR "SFIZZ_SOURCE_DIR is required")
endif()
set(path "${SFIZZ_SOURCE_DIR}/cmake/SfizzDeps.cmake")
file(READ "${path}" original)
set(alias "add_library(sfizz::cxxopts ALIAS sfizz_cxxopts)")
set(guarded "if(NOT TARGET sfizz::cxxopts)\n    ${alias}\nendif()")
string(FIND "${original}" "${guarded}" already)
if(NOT already EQUAL -1)
    message(STATUS "sfizz cxxopts patch already applied")
else()
    string(REGEX MATCHALL "add_library\\(sfizz::cxxopts ALIAS sfizz_cxxopts\\)" matches "${original}")
    list(LENGTH matches count)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "Unexpected sfizz cxxopts declaration count: ${count}; inspect pinned dependency")
    endif()
    string(REPLACE "${alias}" "${guarded}" patched "${original}")
    file(WRITE "${path}" "${patched}")
    message(STATUS "Patched duplicate sfizz cxxopts alias")
endif()
