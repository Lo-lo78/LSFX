diff --git a/src/synth/fluid_synth.c b/src/synth/fluid_synth.c
--- a/src/synth/fluid_synth.c
+++ b/src/synth/fluid_synth.c
@@ -59,6 +59,48 @@
 static int fluid_synth_noteon_LOCAL(fluid_synth_t *synth, int chan, int key,
                                     int vel);
 static int fluid_synth_noteoff_LOCAL(fluid_synth_t *synth, int chan, int key);
+
+/* Private LSFX API; callers serialize synthesis and MIDI operations. */
+FLUIDSYNTH_API int lsfx_fluid_noteon(fluid_synth_t *synth, int chan, int key, int vel,
+                                   int group, int dry_override, float gain, float pan, float pitch)
+{
+    int result;
+    if(!synth || group < 0 || group >= synth->audio_groups) return FLUID_FAILED;
+    fluid_synth_api_enter(synth);
+    synth->lsfx_group_plus_one = group + 1;
+    synth->lsfx_dry_override = dry_override;
+    synth->lsfx_note_gain = gain;
+    synth->lsfx_note_pan = pan;
+    synth->lsfx_note_pitch = pitch;
+    result = fluid_synth_noteon(synth, chan, key, vel);
+    synth->lsfx_group_plus_one = synth->lsfx_dry_override = 0;
+    synth->lsfx_note_gain = synth->lsfx_note_pan = synth->lsfx_note_pitch = 0;
+    fluid_synth_api_exit(synth);
+    return result;
+}
+
+/* Suppress shared sends for inherited auxiliary routes without changing SF2
+ * generator or controller values; explicit note routes retain their own state. */
+FLUIDSYNTH_API int lsfx_fluid_channel_dry(fluid_synth_t *synth, int chan, int dry)
+{
+    int i;
+    if(!synth || chan < 0 || chan >= 16 || chan >= synth->midi_channels) return FLUID_FAILED;
+    dry = dry != 0;
+    fluid_synth_api_enter(synth);
+    if(synth->lsfx_channel_dry[chan] == dry) { fluid_synth_api_exit(synth); return 0; }
+    synth->lsfx_channel_dry[chan] = (unsigned char)dry;
+    for(i = 0; i < synth->polyphony; ++i)
+    {
+        fluid_voice_t *voice = synth->voice[i];
+        if(voice && voice->chan == chan && fluid_voice_is_playing(voice) && voice->lsfx_dry_override == 0)
+        {
+            fluid_voice_update_param(voice, GEN_REVERBSEND);
+            fluid_voice_update_param(voice, GEN_CHORUSSEND);
+        }
+    }
+    fluid_synth_api_exit(synth);
+    return 1;
+}
